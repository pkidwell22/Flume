# Non-secret Docker operator settings. Copy to an untracked .env file if desired.
COMPOSE_PROJECT_NAME=flume-stable
FLUME_IMAGE=flume:stable-candidate
FLUME_HOST_PORT=4410
FLUME_POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Optional: allow a loopback-only Vite frontend to call this stable API.
# WARNING: every create/edit/upload through that frontend writes stable real data.
# FLUME_DEV_ORIGIN=http://127.0.0.1:4510
