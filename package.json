{
  "name": "flume",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:check": "node tools/dev.mjs --check",
    "build": "node tools/dev-workspaces.mjs build",
    "typecheck": "node tools/dev-workspaces.mjs typecheck && tsc -p tsconfig.json",
    "test": "node tools/dev-workspaces.mjs test && npm run test:tooling",
    "test:tooling": "node --test --test-concurrency=1 tools/dev*.test.mjs",
    "flume": "node apps/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
