{
  "name": "@flume/take-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {".": "./src/index.ts", "./styles.css": "./src/styles.css"},
  "sideEffects": ["**/*.css"],
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "test:native": "node test/native/run.mjs",
    "test:mutations": "node test/mutations.mjs"
  },
  "peerDependencies": {"react": ">=19.0.0 <20"},
  "devDependencies": {
    "react": "19.3.1", "react-dom": "19.3.1", "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0", "@types/node": "26.6.5", "@types/jsdom": "30.0.0",
    "typescript": "5.9.3", "tsx": "4.23.15", "jsdom": "30.1.3", "esbuild": "0.28.2"
  }
}
