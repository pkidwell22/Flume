    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "@types/jsdom": "30.0.0",
    "esbuild": "0.28.2"
  }
