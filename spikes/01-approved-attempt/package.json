{
  "name": "approved-attempt-contract-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "26.8.1", "npm": "11.19.0" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node scripts/disposable-postgres.mjs",
    "test:runner": "npm run build && node --test scripts/disposable-postgres.test.mjs",
    "verify": "npm run typecheck && npm run test:runner && npm test && npm run test:recovery",
    "test:recovery": "node scripts/disposable-postgres.mjs recovery",
    "test:recovery:db": "node --test --test-concurrency=1 dist/recovery/recovery.test.js",
    "test:mutations": "npm run build && node scripts/check-mutations.mjs",
    "test:recovery:mutations": "npm run build && node scripts/check-mutations.mjs recovery",
    "test:db": "node --test --test-concurrency=1 dist/test/acceptance.test.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0",
    "pg-boss": "12.11.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.16.0",
    "typescript": "5.9.3"
  }
}
